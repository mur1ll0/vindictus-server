{
  "scope": "Static minimum selection/city path only;not native or client acceptance",
  "source_services_executed": false,
  "native_selection_implemented": false,
  "client_city_verified": false,
  "findings": [
    "Selection index addresses lobby list;not CharacterSN",
    "LoginOk emitted after selection;RegionCode 1 maps to 0;time is signed seconds from Utility epoch",
    "InGame sends environment,summary,stats and skill observers;optional services deferred by operator",
    "EnterChannel requests city admission with channel,partition and ActionSync",
    "ChannelServerAddress directs a second TCP connection;Identify must be first;one-use key consumed even on mismatch",
    "City accept uses MessageAnalyzer with null crypto;do not assume frontend ISAAC or first-packet salt",
    "Client.Enter creates Location,Look,Kinetics and partition observer;movement uses MovePartition and UpdateAction",
    "MapFile reads original .dat topology readonly;bounded parser and client acceptance still pending"
  ],
