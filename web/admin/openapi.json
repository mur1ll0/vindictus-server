{
  "openapi": "3.1.0",
  "info": {
    "title": "Vindictus admin panel",
    "description": "Laboratory administration API (B4).",
    "version": "0.1.0"
  },
  "paths": {
    "/api/accounts": {
      "get": {
        "tags": [
          "accounts"
        ],
        "summary": "Accounts in login order.",
        "operationId": "list",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Part of the login (letters, digits, underscore).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Next page: logins after this one.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1–100, default 50.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AccountSummary"
                  }
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "accounts"
        ],
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccount"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": ""
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{username}/password": {
      "post": {
        "tags": [
          "accounts"
        ],
        "summary": "New password; the account's panel sessions end.",
        "operationId": "set_password",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetPassword"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": ""
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{username}/role": {
      "post": {
        "tags": [
          "accounts"
        ],
        "operationId": "set_role",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetRole"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": ""
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{username}/status": {
      "post": {
        "tags": [
          "accounts"
        ],
        "summary": "Enable or disable an account; disabling ends its panel sessions.",
        "operationId": "set_status",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetStatus"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": ""
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/audit": {
      "get": {
        "tags": [],
        "summary": "Audit events, newest first.",
        "operationId": "audit",
        "parameters": [
          {
            "name": "before_id",
            "in": "query",
            "description": "Only events older than this id (next page).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "action",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "target_kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "target_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1–200, default 50.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditEntry"
                  }
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/play/code": {
      "post": {
        "tags": [],
        "summary": "Game login, step one: any active account (no panel role needed) trades its login and\npassword for a one-time code. Same throttle and lockout as the panel login.",
        "operationId": "play_code",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayCodeResponse"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "tags": [],
        "summary": "The current session, with its CSRF token.",
        "operationId": "session",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/login": {
      "post": {
        "tags": [],
        "summary": "Log in with the game account's login and password; the account needs a panel role.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/logout": {
      "post": {
        "tags": [],
        "operationId": "logout",
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountSummary": {
        "type": "object",
        "required": [
          "username",
          "status",
          "locked",
          "created_at",
          "characters"
        ],
        "properties": {
          "characters": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string",
            "description": "UTC, RFC 3339."
          },
          "game_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Game account name it enters when not its own login (an existing game user)."
          },
          "game_uid": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Game user of its game name, created at the first game login, if any."
          },
          "locked": {
            "type": "boolean",
            "description": "Panel login locked after consecutive wrong passwords."
          },
          "panel_role": {
            "type": [
              "string",
              "null"
            ],
            "description": "admin, gm, leitura or null (no panel access)."
          },
          "status": {
            "type": "string",
            "description": "active or disabled."
          },
          "username": {
            "type": "string"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "description": "Error body of every refused request.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AuditEntry": {
        "type": "object",
        "required": [
          "id",
          "at",
          "action",
          "outcome"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "after": {
            "type": [
              "string",
              "null"
            ],
            "description": "JSON text of the state after the change."
          },
          "at": {
            "type": "string",
            "description": "UTC, RFC 3339 with milliseconds."
          },
          "before": {
            "type": [
              "string",
              "null"
            ],
            "description": "JSON text of the state before the change."
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "outcome": {
            "type": "string"
          },
          "peer": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_kind": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CreateAccount": {
        "type": "object",
        "required": [
          "operation_id",
          "reason",
          "username",
          "password"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "panel_role": {
            "type": [
              "string",
              "null"
            ],
            "description": "Panel role; only an admin can give one.",
            "example": "gm"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "12–128 bytes."
          },
          "reason": {
            "type": "string"
          },
          "username": {
            "type": "string",
            "description": "3–24 letters, digits or underscore (fits the game's account name)."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "format": "password"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "PlayCodeResponse": {
        "type": "object",
        "required": [
          "code",
          "expires_in_seconds"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Type it in the ID field of the game's login screen (password field empty)."
          },
          "expires_in_seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "username",
          "role",
          "csrf_token"
        ],
        "properties": {
          "csrf_token": {
            "type": "string",
            "description": "Send back in the X-CSRF-Token header of every POST/PUT/DELETE."
          },
          "role": {
            "type": "string",
            "example": "admin"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "SetPassword": {
        "type": "object",
        "required": [
          "operation_id",
          "reason",
          "password"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "SetRole": {
        "type": "object",
        "required": [
          "operation_id",
          "reason"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "panel_role": {
            "type": [
              "string",
              "null"
            ],
            "description": "admin, gm, leitura or null to remove panel access.",
            "example": "leitura"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "SetStatus": {
        "type": "object",
        "required": [
          "operation_id",
          "reason",
          "active"
        ],
        "properties": {
          "active": {
            "type": "boolean"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
