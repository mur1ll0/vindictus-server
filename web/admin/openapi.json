    "/api/audit": {
      "get": {
        "tags": [],
        "summary": "Audit events, newest first.",
        "operationId": "audit",
        "parameters": [
          {
            "name": "before_id",
            "in": "query",
            "description": "Only events older than this id (next page).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "action",
            "in": "query",
