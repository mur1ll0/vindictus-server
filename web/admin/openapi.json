  "components": {
    "schemas": {
      "AccountSummary": {
        "type": "object",
        "required": [
          "username",
          "status",
          "locked",
          "created_at",
          "characters"
        ],
        "properties": {
          "characters": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string",
            "description": "UTC, RFC 3339."
          },
          "game_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Game account name it enters when not its own login (an existing game user)."
          },
          "game_uid": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Game user of its game name, created at the first game login, if any."
          },
          "locked": {
            "type": "boolean",
            "description": "Panel login locked after consecutive wrong passwords."
          },
          "panel_role": {
            "type": [
              "string",
              "null"
            ],
            "description": "admin, gm, leitura or null (no panel access)."
          },
          "status": {
            "type": "string",
            "description": "active or disabled."
          },
          "username": {
            "type": "string"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "description": "Error body of every refused request.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AuditEntry": {
        "type": "object",
        "required": [
          "id",
          "at",
          "action",
          "outcome"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "after": {
            "type": [
              "string",
              "null"
            ],
            "description": "JSON text of the state after the change."
          },
          "at": {
            "type": "string",
            "description": "UTC, RFC 3339 with milliseconds."
          },
          "before": {
            "type": [
              "string",
              "null"
            ],
            "description": "JSON text of the state before the change."
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "outcome": {
            "type": "string"
          },
          "peer": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_kind": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CharacterItem": {
        "type": "object",
        "required": [
          "id",
          "class",
          "count",
          "collection",
          "slot",
          "tradable",
          "attributes"
        ],
        "properties": {
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemAttribute"
            }
          },
          "class": {
            "type": "string"
          },
          "collection": {
            "type": "integer",
            "format": "int32",
            "description": "0–8 bags, 100 cash, 101 account (gold), 102 restore, 103 story."
          },
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "durability_lost": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "equipped_part": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Equipped body part (game_equippables.part), when worn."
          },
          "expires_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Expiry as Unix seconds."
          },
          "id": {
            "type": "string",
            "description": "Item ID (64-bit, as text)."
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "slot": {
            "type": "integer",
            "format": "int32"
          },
          "tradable": {
            "type": "boolean"
          }
        }
      },
      "CharacterSheet": {
        "type": "object",
        "required": [
          "summary",
          "owner",
          "gold",
          "stats",
          "items",
          "skills",
          "status_effects",
          "titles"
        ],
        "properties": {
          "gold": {
            "type": "integer",
            "format": "int64"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CharacterItem"
            }
          },
          "owner": {
            "type": "string",
            "description": "Login (game account name) of the owner."
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CharacterSkill"
            }
          },
          "stats": {
            "$ref": "#/components/schemas/CharacterStats"
          },
          "status_effects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CharacterStatusEffect"
            }
          },
          "summary": {
            "$ref": "#/components/schemas/CharacterSummary"
          },
          "titles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CharacterTitle"
            }
          }
        }
      },
      "CharacterSkill": {
        "type": "object",
        "required": [
          "skill",
          "rank",
          "locked"
        ],
        "properties": {
          "locked": {
            "type": "boolean"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "rank": {
            "type": "integer",
            "format": "int32"
          },
          "skill": {
            "type": "string"
          }
        }
      },
      "CharacterStats": {
        "type": "object",
        "required": [
          "str",
          "dex",
          "int",
          "will",
          "luck",
          "hp",
          "stamina",
          "total_used_ap",
          "play_time"
        ],
        "properties": {
          "dex": {
            "type": "integer",
            "format": "int32"
          },
          "hp": {
            "type": "integer",
            "format": "int32"
          },
          "int": {
            "type": "integer",
            "format": "int32"
          },
          "luck": {
            "type": "integer",
            "format": "int32"
          },
          "play_time": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds played."
          },
