public interface ItemStackTrait {ItemClassInfo ItemClassInfo{get;}}
public class VirtualCreateItem:ItemStackTrait{public Property Property;public int Num;public ItemLocation Location;public ItemClassInfo ItemClassInfo{get{return Property.ItemClassInfo;}}public VirtualCreateItem(object parent,Property property,int num,long? before){Property=property;Num=num;}public void SetLocation(ItemLocation l){Location=l;}}
public class GiveItemRequest{public ItemClassInfo ItemClassInfo;public int Num;public string ItemClass{get{return ItemClassInfo.ItemClass;}}}
public class ItemStorage{}
public class ClassHelper{
 public ItemClassInfo ItemClassInfo;public List<GiveItemRequest> GiveRequests=new List<GiveItemRequest>();public List<VirtualCreateItem> Created=new List<VirtualCreateItem>(),Created_UniqueFail=new List<VirtualCreateItem>();public object Parent;
 __BUNDLE__
 __CREATEVIRTUAL__
 public string Build(int count){
  if(count<0||ItemClassInfo.MaxStack<=0)return "Bound";
  GiveRequests.Add(new GiveItemRequest{ItemClassInfo=ItemClassInfo,Num=count});if(BundleExceed())return "Limit";
  int left=ItemClassInfo.UniqueConstraintLeft(0);var p=new Property{ItemClassInfo=ItemClassInfo};
  while(count>0)count-=CreateItem(p,count,ref left,null);
  return Created_UniqueFail.Count>0?"Limit":null;
 }
}
