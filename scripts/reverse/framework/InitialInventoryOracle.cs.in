public static class Oracle{
 static JavaScriptSerializer ser=new JavaScriptSerializer{MaxJsonLength=64*1024*1024+4096};
 static byte[] Hex(string s){var b=new byte[s.Length/2];for(int i=0;i<b.Length;i++)b[i]=Convert.ToByte(s.Substring(i*2,2),16);return b;}
 static string Text(object s){return s==null?null:Encoding.Unicode.GetString(Hex((string)s));}
 static object Get(Dictionary<string,object>d,string key){return d[key];}
 static int I(object v){return Convert.ToInt32(v,CultureInfo.InvariantCulture);}
 static List<VirtualCreateItem> Plan(List<Tuple<ItemClassInfo,int>> requests,out string error){
  error=null;var created=new List<VirtualCreateItem>();
  foreach(var r in requests){var h=new ClassHelper{ItemClassInfo=r.Item1};error=h.Build(r.Item2);if(error!=null)return null;created.AddRange(h.Created);}
  var cash=new CashStorage();var bag=new BagStorage();List<VirtualCreateItem> bound,left;var result=new List<VirtualCreateItem>();
  cash.BindVirtualItem(created,new HashSet<long>(),new List<ItemLocation>(),out bound,out left);result.AddRange(bound);
  bag.BindVirtualItem(left,new HashSet<long>(),new List<ItemLocation>(),out bound,out left);result.AddRange(bound);
  if(left.Count>0){error="Full";return null;}return result;
 }
 static string Digest(List<Item> items,long owner){
  using(var stream=new MemoryStream())using(var w=new BinaryWriter(stream)){
   w.Write(Encoding.UTF8.GetBytes("FionaInventory\0v1"));w.Write(owner);w.Write(items.Count);
   foreach(var r in items){
    w.Write(r.ID);var key=Encoding.Unicode.GetBytes(r.ItemClass);w.Write(key.Length);w.Write(key);w.Write(r.Count);w.Write(r.Location.Collection);w.Write(r.Location.Slot);
    w.Write((byte)(r.ExpireDateTime.HasValue?1:0));if(r.ExpireDateTime.HasValue)w.Write(r.ExpireDateTime.Value.Ticks);
    w.Write((byte)1);w.Write((byte)(r.CheckSum.HasValue?1:0));if(r.CheckSum.HasValue)w.Write(r.CheckSum.Value);
    w.Write((byte)(r.Equippable!=null?1:0));if(r.Equippable!=null){w.Write(r.Equippable.Color1);w.Write(r.Equippable.Color2);w.Write(r.Equippable.Color3);w.Write(r.ReducedDurability);w.Write(r.MaxDurabilityBonus);}
   }w.Flush();return BitConverter.ToString(SHA256.Create().ComputeHash(stream.ToArray())).Replace("-","").ToLowerInvariant();
  }
 }
 static void Private(string input){
  var wrapper=ser.Deserialize<Dictionary<string,object>>(input);var p=(Dictionary<string,object>)wrapper["profile"];var catalog=(Dictionary<string,object>)wrapper["catalog"];var stats=(Dictionary<string,object>)wrapper["stats"];var colors=(Dictionary<string,object>)wrapper["colors"];
  FeatureMatrix.MaterialPathString=(string)wrapper["material_root"];foreach(Dictionary<string,object>f in(ArrayList)p["features"])FeatureMatrix.map[(string)f["key"]]=(string)f["value"]??"";
  ItemClassConst.Gold=Text(p["gold_utf16"]);ItemClassConst.TirCoin=Text(p["tircoin_utf16"]);
  var equipRows=(ArrayList)catalog["equips"];var statRows=(ArrayList)stats["rows"];var colorRows=(ArrayList)colors["rows"];var equips=new Dictionary<string,Tuple<EquipItemInfo,int>>();
  for(int i=0;i<equipRows.Count;i++){
   var e=(Dictionary<string,object>)equipRows[i];if(!FeatureMatrix.IsEnable((string)e["feature"]))continue;
   var s=(Dictionary<string,object>)statRows[i];var c=(Dictionary<string,object>)colorRows[i];var names=(ArrayList)c["materials"];var info=new EquipItemInfo{MaxDurability=I(s["max_durability"]),Material1=Text(names[0]),Material2=Text(names[1]),Material3=Text(names[2])};equips[Text(e["item_utf16"])]=Tuple.Create(info,i);
  }
  var rawClasses=(ArrayList)p["classes"];var classRows=(ArrayList)catalog["classes"];var groups=new Dictionary<string,int>();
  foreach(Dictionary<string,object>r in(ArrayList)p["requests"]){if(r["feature"]!=null&&!FeatureMatrix.IsEnable((string)r["feature"]))continue;string key=Text(r["item_utf16"]);int previous;groups[key]=groups.TryGetValue(key,out previous)?unchecked(previous+I(r["num"])):I(r["num"]);}
  var requests=new List<Tuple<ItemClassInfo,int>>();
  foreach(var g in groups){
   int matches=0;ItemClassInfo info=null;
   for(int i=0;i<classRows.Count;i++){var c=(Dictionary<string,object>)classRows[i];if(Text(c["item_utf16"])!=g.Key||!FeatureMatrix.IsEnable((string)c["feature"]))continue;matches++;var m=(Dictionary<string,object>)rawClasses[i];Tuple<EquipItemInfo,int>e;equips.TryGetValue(g.Key,out e);info=new ItemClassInfo{ItemClass=g.Key,MaxStack=I(c["max_stack"]),Storage=I(c["storage"]),Unique=I(m["unique"]),ExpireIn=m["expire_in"]==null?(int?)null:I(m["expire_in"]),equipment=e==null?null:e.Item1,stat=new ItemStat{MaxDurability=e==null?0:e.Item1.MaxDurability}};}
   if(matches!=1||info==null||info.Storage<1||info.Storage>2)throw new Exception("Outside admitted unique-row source profile");ItemContents.classes[g.Key]=info;requests.Add(Tuple.Create(info,g.Value));
  }
  string error;var plan=Plan(requests,out error);if(error!=null)throw new Exception("Source initial plan refused");
  Clock.calls=0;ColorTable.Reset(0);var authority=new Authority();var result=new List<Item>();
  foreach(var v in plan){var r=new Item{ID=authority.MakeEntityID().Ticks};if(!r.Initialize(v.Property,v.Num))throw new Exception("Original Initialize refused");r.OwnerID=1;r.Location=v.Location;r.Collection=v.Location.Collection;r.Slot=v.Location.Slot;new Checker().SetCheckSum(r);result.Add(r);}
  Console.WriteLine(ser.Serialize(new{items=result.Count,equipment=result.Count(r=>r.Equippable!=null),cash_items=result.Count(r=>r.Collection==100),bag_items=result.Count(r=>r.Collection!=100),clock_calls=Clock.calls,projection_sha256=Digest(result,1),values_emitted=false}));
 }
 public static void Main(string[]args){
  CultureInfo.CurrentCulture=CultureInfo.GetCultureInfo("en-US");
  if(args.Length==1&&args[0]=="--feature-pairs"){
   var input=ser.Deserialize<Dictionary<string,object>>(Console.In.ReadToEnd());var result=new List<object>();
   foreach(Dictionary<string,object> p in(ArrayList)input["pairs"]){string current=(string)p["current"],value=(string)p["value"];FeatureMatrix.map["CurrentVer"]=current;FeatureMatrix.map["candidate"]=value;result.Add(new{current=current,value=value,enabled=FeatureMatrix.IsEnable("candidate")});}
   Console.WriteLine(ser.Serialize(result));return;
  }
  if(args.Length==1&&args[0]=="--private-stdin"){Private(Console.In.ReadToEnd());return;}
  FeatureMatrix.map["CurrentVer"]="3.09.00";FeatureMatrix.map["MaxDurabilityLimit"]="30000";FeatureMatrix.map["BundleExceed"]="0";
  var validity=new List<object>();int[] edges={int.MinValue,-1,0,1,100,int.MaxValue};uint state=73129;
  for(int i=0;i<2000;i++){
   int[] v=new int[5];for(int j=0;j<5;j++){state=unchecked(state*1664525+1013904223);v[j]=edges[state%6];}
   FeatureMatrix.map["MaxDurabilityLimit"]=v[4].ToString(CultureInfo.InvariantCulture);FeatureMatrix.map["CheckEquipItemInfoVaild"]=i%2==0?"":"1.0";
   var info=new ItemClassInfo{ItemClass="synthetic",MaxStack=1,equipment=new EquipItemInfo{MaxDurability=v[0]}};
   var item=new Item{ItemClassInfo=info,ItemClass="synthetic",Stat=new ItemStat{MaxDurability=v[1]},Equippable=new Equippable{MaxDurabilityBonus=v[2],ReducedDurability=v[3]},Count=1,Location=new ItemLocation(255,-1)};
   bool valid=item.IsValid();validity.Add(new{input=v,output=new[]{valid?1:0,item.MaxDurability,item.Durability,item.ReducedDurability,item.MaxDurabilityBonus}});
  }
  var checks=new List<object>();string[] names={"gold_synthetic","other","漢字","\ud800","a\0b","\ud800\udc00"};long[] ids={long.MinValue,-1,0,1,638448480000000000,long.MaxValue};long?[] owners={null,long.MinValue,-1,0,long.MaxValue};int[] counts={int.MinValue,-1,0,1,int.MaxValue};
  foreach(string name in names)foreach(long id in ids)foreach(var owner in owners)foreach(int count in counts){
   var item=new Item{ID=id,OwnerID=owner,ItemClass=name,Count=count};checks.Add(new{units=name.Select(c=>(int)c).ToArray(),id=id.ToString(CultureInfo.InvariantCulture),owner=owner.HasValue?owner.Value.ToString(CultureInfo.InvariantCulture):null,count=count,value=new Checker().GetCheckSum(item)});
  }
  var plans=new List<object>();
  for(int n=0;n<96;n++){
   FeatureMatrix.map["BundleExceed"]=(n%8==0?2:0).ToString();var requests=new List<Tuple<ItemClassInfo,int>>();var inputs=new List<int[]>();
   for(int j=0;j<1+n%7;j++){int storage=(n+j)%3==0?2:1,max=1+(n*7+j)%5,count=(n*13+j*29)%120,unique=j%4==0?50:0;var info=new ItemClassInfo{ItemClass="synthetic_"+j,Storage=storage,MaxStack=max,Unique=unique};requests.Add(Tuple.Create(info,count));inputs.Add(new[]{storage,max,count,unique});}
   string error;var p=Plan(requests,out error);plans.Add(new{input=inputs,bundle=n%8==0?2:0,error=error,output=p==null?null:p.Select(v=>new[]{int.Parse(v.ItemClassInfo.ItemClass.Substring(10)),v.Num,(int)v.Location.Collection,v.Location.Slot}).ToArray()});
  }
  Console.WriteLine(ser.Serialize(new{validity=validity,checks=checks,plans=plans}));
 }
}
