using System;using System.Linq;using System.Collections;using System.Collections.Generic;using System.Web.Script.Serialization;
class UserInfo{public int NexonSN;public long? LastLoginCID;public bool ProloguePlayed;public UserInfo Clone(){return new UserInfo{NexonSN=NexonSN,LastLoginCID=LastLoginCID,ProloguePlayed=ProloguePlayed};}}
class Table<T>:IQueryable<T>{public List<T> Rows=new List<T>();private IQueryable<T> Query{get{return Rows.AsQueryable();}}public Type ElementType{get{return Query.ElementType;}}public System.Linq.Expressions.Expression Expression{get{return Query.Expression;}}public IQueryProvider Provider{get{return Query.Provider;}}public IEnumerator<T> GetEnumerator(){return Rows.GetEnumerator();}IEnumerator IEnumerable.GetEnumerator(){return GetEnumerator();}public void InsertOnSubmit(T value){Rows.Add(value);}}
class Context{public Table<UserInfo> UserInfo=new Table<UserInfo>();public List<UserInfo> Persisted=new List<UserInfo>();public bool Fail;public int Submitted;public void SubmitChanges(){Submitted++;if(Fail)throw new InvalidOperationException("synthetic submit failure");Persisted=UserInfo.Rows.Select(r=>r.Clone()).ToList();}
__RECOVERED_METHOD__

}
class Oracle{static object Rows(IEnumerable<UserInfo> rows){return rows.OrderBy(r=>r.NexonSN).Select(r=>new{uid=r.NexonSN,last_cid=r.LastLoginCID.HasValue?r.LastLoginCID.Value.ToString():null,played=r.ProloguePlayed}).ToArray();}
static void Main(){var cases=new List<object>();foreach(int uid in new[]{17,-17,int.MinValue,int.MaxValue})foreach(bool present in new[]{false,true})foreach(long? cid in present?new long?[]{null,0,42,long.MaxValue}:new long?[]{null})foreach(bool played in present?new[]{false,true}:new[]{false})foreach(bool fail in new[]{false,true}){
var c=new Context{Fail=fail};c.UserInfo.Rows.Add(new UserInfo{NexonSN=0,LastLoginCID=99,ProloguePlayed=false});if(present)c.UserInfo.Rows.Add(new UserInfo{NexonSN=uid,LastLoginCID=cid,ProloguePlayed=played});c.Persisted=c.UserInfo.Rows.Select(r=>r.Clone()).ToList();var before=Rows(c.Persisted);string error=null;try{c.ProloguePlayed(uid);if(!fail)c.ProloguePlayed(uid);}catch(Exception e){error=e.GetType().Name;}cases.Add(new{uid,before,after=Rows(c.Persisted),submitted=c.Submitted,error});}
Console.WriteLine(new JavaScriptSerializer{MaxJsonLength=4*1024*1024}.Serialize(new{architecture=IntPtr.Size==4?"x86":"x64",cases}));}}