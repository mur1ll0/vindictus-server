using System;using System.Linq;using System.Collections.Generic;using System.Web.Script.Serialization;
using CharacterEntity=Entity;using SkillManager=Manager;
public static class Bomb {public static int Hits;public static void Hit(){Hits++;throw new InvalidOperationException("guard crossed");}}
public class Skill{public string SkillID;public int Rank;}
public class SkillRankInfo{public int Rank;}
public class SkillArgumentInfo{public string KeyWord;public int? Value;}
public class Info{public byte Class=1;public int Level=1;public int AP;public DateTime LastAPUpdate;}
public class Character{public List<Skill> Skill=new List<Skill>();public Info CharacterInfo=new Info();public int GuildId;}
public static class DictionaryExtension{public static int TryGetValue(this Dictionary<string,int>d,string k){int v;return d.TryGetValue(k,out v)?v:0;}}
public static class CharacterContents{public static List<SkillArgumentInfo> Rows;public static IEnumerable<SkillArgumentInfo> GetSkillArgumentInfo(string id,int rank){return Rows;}public static double GetMediumLoadWeight(byte c,int l){Bomb.Hit();return 0;}public static double GetHeavyLoadMultiplier(){Bomb.Hit();return 0;}public static IEnumerable<GuildScoreEvaluateInfo> GuildScoreSheet{get{Bomb.Hit();return null;}}}
namespace ServiceCore{public static class FeatureMatrix{public static int GameCode,ServerCode;public static bool IsEnable(string s){return false;}}}
public class GuildScoreEvaluateInfo{public string Event,StringValue;public int? IntValue;public int EventCode,Score;}
public class GuildReportDataContext:IDisposable{public GuildReportDataContext(){Bomb.Hit();}public void UpdateGuildRankingBasisScore(params object[] p){Bomb.Hit();}public void Dispose(){}}
public class Logger{public void Warn(string s){Bomb.Hit();}public void Error(params object[] p){}public void InfoFormat(params object[] p){Bomb.Hit();}}
public static class Log<T>{public static Logger Logger=new Logger();}
public class ObserverProxy{public void SetDirty(){Bomb.Hit();}}
public class Observable{private Dictionary<int,ObserverProxy> proxies=new Dictionary<int,ObserverProxy>();public event EventHandler CacheUpdated;
 __UPDATED__
 public void Probe(){proxies.Add(1,new ObserverProxy());}
}
