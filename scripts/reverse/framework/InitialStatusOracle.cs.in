class Oracle {
 static object Run(int n,int mode) {
  Events.Clear();Utility.ProfileScope.Clear();
  var p=new PlayerEntity(new Service(),new Entity{ID=n==1?long.MaxValue:n-16});
  var c=new CharacterEntity{Player=p};
  if(p.FrontendConn!=null||p.Character!=null||!object.ReferenceEquals(p.ObservableCollection.Bound,p.Entity))throw new Exception("source player boundary");
  if(mode==1)Events.FailClock=true;
  if(mode>=2)p.FrontendConn=new object();
  if(mode>=3)p.Character=c;
  if(mode==4)Events.FailFrontend=true;
  StatusEffectManager status=null;TownCampfireManager fire=null;bool success=true;
  try {status=new StatusEffectManager(c);fire=new TownCampfireManager(c);}catch(InvalidOperationException){success=false;}
  var profile=Utility.ProfileScope.DataList.Single();
  return new {cid=p.CID,mode=mode,success=success,clock_calls=Events.ClockCalls,submits=Events.Submits,stat_calculations=Events.Stats,pushes=Events.Pushes,frontend=Events.Frontend,micro=Events.Micro,reloads=Events.Reload,
   profile_calls=profile.TotalCallCount,profile_valid=profile.MinDuration>=0&&profile.MaxDuration>=profile.MinDuration&&profile.TotalDuration>=profile.MaxDuration&&profile.AvgDuration==profile.TotalDuration,
   expected=status==null?null:new{types=status.StatusEffectByType.Count,tags=status.StatusEffectByTag.Count,need_db=status.NeedDBSubmit,need_stat=status.NeedUpdateStat,updated=status.StatusEffectUpdatedCount,stats=status.StatusEffectStat.Values,same_context=status.SameCharacter(c)&&fire.SameCharacter(c),campfire=fire.Status}};
 }
 static void Main(){var cases=new List<object>();for(int n=0;n<32;n++)cases.Add(Run(n,n%4==0?1:0));var probes=new List<object>();for(int mode=2;mode<=4;mode++)probes.Add(Run(0,mode));Console.WriteLine(new JavaScriptSerializer().Serialize(new{cases=cases,probes=probes}));}
}
