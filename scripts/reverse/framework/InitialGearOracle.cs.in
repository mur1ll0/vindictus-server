using System;using System.Collections.Generic;using System.Linq;using System.Web.Script.Serialization;using ServiceCore.CharacterServiceOperations;using Utility;
namespace Utility {
 public static class Extensions {public static int Linear(this int value,int bonus){throw new Exception("unexpected mastery");}public static V TryGetValue<K,V>(this Dictionary<K,V> d,K k){V v;return d.TryGetValue(k,out v)?v:default(V);}}
 public class MultiDictionary<K,V>{public IEnumerable<K> Keys{get{return new K[0];}}public bool Contains(K k,V v){throw new Exception("unexpected set");}public void Add(K k,V v){throw new Exception("unexpected set");}public int CountValues(K k){throw new Exception("unexpected set");}}
}
namespace ServiceCore {public static class FeatureMatrix {public static bool Avatar,Bonus;public static bool IsEnable(string key){return key=="Avatar"?Avatar:key=="AvatarSlotBonus"?Bonus:throw new Exception("unexpected feature");}}}
public class EquipPartInfo {public int EquipPartNum;public int? CostumePartNum;public string CostumeCategory;public bool IsConsumable,IsExpandedSlot;}
public class ItemClassInfo {public string ExtraData,Category,ItemClass;public int Level;public EquipItemInfo GetEquipItemInfo(){throw new Exception("unexpected item");}}
public class EquipItemInfo{public string EquipClass;public int CostumeType;}
public class ItemStat{public int Weight,ArmorHP,DEF_Destroyed;public CharacterStats ToCharacterStats(){throw new Exception("unexpected item");}}
public class Item {public EquipPartInfo EquippedPartInfo;public ItemClassInfo ItemClassInfo,LookClassInfo;public bool IsExpired,IsAvatarPartItem,IsSetItem;public int? BadStatus;public ItemStat Stat;public int Color1,Color2,Color3,Durability,MaxDurability;public Equippable Equippable;public bool HasAttributeEntity(string s){throw new Exception("unexpected item");}public Enhance Enhance;}
public class Equippable{public int Color1,Color2,Color3;}public class Enhance{public int Effect;}
public class SetInfo{public string SetID;public Dictionary<string,int> GetSetEffect(int i){throw new Exception("unexpected set");}}
public static class EquipExtensions{public static List<SetInfo> GetSetInfos(this EquipItemInfo m){throw new Exception("unexpected set");}}
public class AvatarSetBonusInfo{public int STR,DEX,INT,WILL,LUCK,HP,STAMINA,ATK,DEF,MATK;}
public class SetBonusInfo{public CharacterStats SetStatBonus;public Dictionary<string,int> SetSkillBonus;}
public static class ItemContents {
 public static int Queries;
 public static ItemClassInfo GetItemClassInfo(string s){Queries++;throw new Exception("unexpected item");}
 public static IEnumerable<int> GetEquippablePart(string s){Queries++;throw new Exception("unexpected item");}
 public static EquipPartInfo GetEquipPartInfo(int n,string s){Queries++;throw new Exception("unexpected item");}
 public static SetInfo GetSetInfo(string s){Queries++;throw new Exception("unexpected set");}
 public static AvatarSetBonusInfo GetAvatarSetBonusInfoByPartsCount(int n){Queries++;throw new Exception("unexpected avatar set");}
}
public static class CostumeManager {public static Dictionary<string,int> CostumeKeyDict=new Dictionary<string,int>(),DecorationKeyDict=new Dictionary<string,int>();}
public class CostumeInfo{public Dictionary<int,int> AvatarHideInfo=new Dictionary<int,int>();}
public class Costumes{public CostumeInfo CostumeInfo=new CostumeInfo();}
public class Character{public Costumes Costume=new Costumes();}
public class CharacterWrapper{public Character Character=new Character();}
public class Owner {public CharacterWrapper Character=new CharacterWrapper();}
public class EquippableSlot {
 public byte Part;public bool IsEmpty=true,ItemDisabled;public Dictionary<string,EquipPartInfo> EquipPartInfos=new Dictionary<string,EquipPartInfo>();private Item Data=null;
 __SLOT__
}
public class SkillEffect {private int Arg(string s,string k){return 0;} __ITEM__ }
public class Gear {
 public Owner Parent=new Owner();public Dictionary<int,EquippableSlot> Equipments=new Dictionary<int,EquippableSlot>();
 public IEnumerable<Item> EquippedItems{get{return new Item[0];}}
 public Item GetEquippedItem(int part){return null;}
 __AVATAR__
 __GEAR__
 __SET__
}
public class Row {public int slot;public string category;public int? costume_part;public bool decoration,consumable;}
public class Input {public Row[] rows;public bool avatar,bonus;}
public static class Oracle{
 static JavaScriptSerializer Json=new JavaScriptSerializer{MaxJsonLength=int.MaxValue};
 static int[] StatsOf(CharacterStats s){var v=new int[25];for(int i=0;i<25;i++)v[i]=s[(Stats)i];return v;}
 public static object Run(Input input){
 ServiceCore.FeatureMatrix.Avatar=input.avatar;ServiceCore.FeatureMatrix.Bonus=input.bonus;ItemContents.Queries=0;
 var gear=new Gear();var groups=new Dictionary<int,List<Row>>();foreach(var r in input.rows){List<Row> list;if(!groups.TryGetValue(r.slot,out list)){list=new List<Row>();groups.Add(r.slot,list);}list.Add(r);}
 foreach(var p in groups){if(p.Value[0].consumable)continue;var slot=new EquippableSlot{Part=(byte)p.Key,ItemDisabled=true};
 foreach(var r in p.Value)slot.EquipPartInfos.Add(r.category,new EquipPartInfo{EquipPartNum=r.slot,CostumePartNum=r.costume_part,CostumeCategory=r.decoration?"Decoration":null,IsConsumable=r.consumable,IsExpandedSlot=true});
 gear.Equipments.Add(p.Key,slot);}
 var set=gear.ToSetBonusInfo();var infos=gear.ToEquippedItemInfos();
 CharacterStats itemStats=null;double weight=0;Dictionary<int,int> hp=null;IDictionary<int,int> def=null;bool duplicate=false;
 try{new SkillEffect().ApplyItemSkills(set.SetStatBonus,infos,out itemStats,out weight,out hp,out def);}catch(ArgumentException){duplicate=true;}
 var hpMap=new Dictionary<string,int>();foreach(var pair in hp)hpMap.Add(pair.Key.ToString(),pair.Value);
 var defMap=new Dictionary<string,int>();foreach(var pair in def)defMap.Add(pair.Key.ToString(),pair.Value);

 return new{input=input,item_stats=StatsOf(itemStats),item_weight_bits=BitConverter.DoubleToInt64Bits(weight).ToString("x16"),hp=hpMap,def=defMap,duplicate=duplicate,gear_slots=gear.Equipments.Count,rows=infos.Select(r=>new{part=r.PartNum,decoration=r.IsDecoration,costume_part=r.CostumePartNum,serial=r.CostumeSN,colors=new[]{r.Color1,r.Color2,r.Color3},level=r.ItemLevel,weight_bits=BitConverter.DoubleToInt64Bits(r.Weight).ToString("x16"),durability=r.Durability,maximum=r.MaxDurability,hp=r.ArmorHP,equip_class=r.EquipClass,item_class=r.ItemClass,avatar=r.IsAvatar,stats=StatsOf(r.StatBonus),destroyed=r.DEF_Destroyed,effect=r.Effect}).ToArray(),set=StatsOf(set.SetStatBonus),set_skill_count=set.SetSkillBonus.Count,unexpected_provider_calls=ItemContents.Queries};
 }
 public static void Main(string[] args){
 if(args.Length>0){Console.WriteLine(Json.Serialize(Run(Json.Deserialize<Input>(Console.In.ReadToEnd()))));return;}
 var cases=new List<object>();
 for(int i=0;i<160;i++){
 var rows=new List<Row>();for(int j=0;j<i%17;j++)rows.Add(new Row{slot=(j*3+i)%7,category="synthetic_"+j,costume_part=j%4==0?(int?)null:j%4==1?4:j%4==2?2:-1,decoration=(j+i)%3==0,consumable=(j+i)%5==0});
 if(i>=128)rows.Reverse();cases.Add(Run(new Input{rows=rows.ToArray(),avatar=i%2==0,bonus=i%3==0}));
 }
 Console.WriteLine(Json.Serialize(cases));
 }
}
