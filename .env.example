# Copy to .env and replace both passwords with generated, unique values.
# Use URL-safe characters (letters, digits, underscore, hyphen) for POSTGRES_PASSWORD.
POSTGRES_USER=postgres
POSTGRES_DB=vindictus
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_BOOTSTRAP_PASSWORD
APP_DATABASE_USER=vindictus_app
APP_DATABASE_PASSWORD=REPLACE_WITH_DIFFERENT_GENERATED_URL_SAFE_PASSWORD
POSTGRES_HOST_PORT=5433
# Disposable test database (compose profile "tests"); change it if Windows reserves the port.
TEST_POSTGRES_HOST_PORT=57432
HTTP_HOST_PORT=8080
RUST_LOG=info
# Optional study-only SQL Server Developer profile. EULA: https://go.microsoft.com/fwlink/?linkid=857698
MSSQL_ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=REPLACE_WITH_GENERATED_STRONG_PASSWORD
MSSQL_HOST_PORT=14333

# Protected laboratory runtime profile (prepared by scripts/dev/prepare-lab-frontend-profile.ps1)
# mounted as a secret by the game service.
LAB_RUNTIME_PROFILE=./.cache/private-frontend/runtime-profile.json
# Build through the classic builder: the bake path fails on this Docker Desktop (frontend grpc server closed unexpectedly).
COMPOSE_BAKE=false
# Playing from other computers (docs/future/game-launcher.md 4.9): publish the game ports on every
# interface and advertise this host's LAN or VPN IPv4. Default: loopback only.
# PUBLISH_ADDRESS=0.0.0.0
# PUBLIC_HOST=192.168.1.13
# Update store and the folder of its private key (client-dist keygen); never versioned.
# CLIENT_DIST_DIR=./.cache/client-dist
# CLIENT_DIST_KEYS_DIR=./.cache/client-dist-keys
